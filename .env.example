# Instagram credentials are optional. Without them the CLI, API, and dashboard
# can still run with deterministic demo data.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Local session/cache settings
SESSION_DIR=./sessions
LOG_LEVEL=INFO

# Keep this at 0 for local development and tests. Increase for live scraping.
RATE_LIMIT_DELAY=0

# Optional sklearn-style model paths for BotDetector
BOT_MODEL_PATH=
BOT_SCALER_PATH=
